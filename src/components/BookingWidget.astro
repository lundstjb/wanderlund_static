---
/**
 * Hospitable direct booking widget. The loader inserts an iframe right after
 * its own <script> tag, so the tag must stay inline (not bundled by Astro).
 * Falls back to the Airbnb link when a property has no Hospitable ID.
 */
import type { Property } from "../data/properties";

interface Props {
  property: Property;
}

const SITE_UUID = "a3374bb8-0ffc-4c17-9822-619c228839a8";
const { property } = Astro.props;
---

{
  property.hospitablePropertyId ? (
    <div class="booking-widget">
      <script
        is:inline
        src="https://cdn.hsptb.com/direct-booking-widget/widget-loader.prod.js"
        data-site-uuid={SITE_UUID}
        data-property-id={property.hospitablePropertyId}
        data-theme="multi"
      />
    </div>
  ) : (
    <a class="btn btn-primary w-full" href={property.airbnbUrl} target="_blank">
      Check Availability
    </a>
  )
}
