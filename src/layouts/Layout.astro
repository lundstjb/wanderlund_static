---
import "../styles/global.css";
import { absoluteUrl, jsonLdString, organizationSchema } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  /** Site path of the social preview image. */
  image?: string;
  /** Page-specific JSON-LD, added after the organization block. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Boutique vacation rentals and short-term rental property management in Knoxville, TN.",
  image,
  jsonLd,
} = Astro.props;

const fullTitle = `${title} | Wanderlund`;
const canonical = absoluteUrl(Astro.url.pathname.replace(/index\.html$/, ""));
const schemas = jsonLd ? [organizationSchema(), jsonLd] : [organizationSchema()];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wanderlund" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={absoluteUrl(image)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <script type="application/ld+json" set:html={jsonLdString(schemas)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
