---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { properties } from "../data/properties";
---

<Layout
  title="Knoxville Vacation Rentals & Short-Term Rental Management"
  description="Boutique vacation rentals in Knoxville, TN, and full-service short-term rental property management for Knoxville owners."
>
  <Header />

  <main>
    <section class="hero">
      <div class="container hero-content">
        <h1>Knoxville Vacation Rentals & Property Management</h1>
        <p>
          Discover hand-picked properties in Knoxville Tennessee. Experience
          comfort, care, and quality.
        </p>
        <div class="hero-actions">
          <a href="/properties/" class="btn btn-primary">Find a Stay</a>
          <a href="/contact/" class="btn btn-light">Manage Your Property</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Featured Properties</h2>
          <p>Expertly-curated homes for your next unforgettable getaway.</p>
        </div>
        <div class="property-grid">
          {properties.map((property) => <PropertyCard property={property} />)}
        </div>
      </div>
    </section>

    <section class="section bg-secondary">
      <div class="container">
        <div class="services-grid">
          <div class="service-content">
            <h2>Short-Term Rental Management in Knoxville</h2>
            <p>
              We handle everything from marketing and guest communication to
              maintenance and housekeeping, so you can enjoy the benefits of
              ownership without the hassle.
            </p>
            <ul class="check-list">
              <li>Professional Photography & Listing Optimization</li>
              <li>Guest Screening & 24/7 Support</li>
              <li>Local Maintenance & Housekeeping Teams</li>
              <li>Dynamic Pricing for Maximum Revenue</li>
            </ul>
            <div class="service-actions">
              <a href="/contact/" class="btn btn-primary"
                >Talk to Us About Your Property</a
              >
              <a href="/services/" class="text-link">See what management includes</a>
            </div>
          </div>
          <div class="service-image">
            <img
              src="/images/knoxville-skyline.jpg"
              alt="Knoxville skyline at dusk with the Sunsphere"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    background: linear-gradient(
        to top,
        rgba(24, 18, 12, 0.86) 0%,
        rgba(24, 18, 12, 0.72) 48%,
        rgba(24, 18, 12, 0.4) 64%,
        rgba(24, 18, 12, 0.1) 82%,
        rgba(24, 18, 12, 0) 100%
      ),
      url("/images/properties/jackson/EL8A9744.jpg");
    background-size: cover;
    background-position: center;
    height: 90vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5rem;
    color: white;
    text-align: center;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero h1,
  .hero p {
    text-shadow: 0 1px 18px rgba(24, 18, 12, 0.45);
  }

  .hero h1 {
    font-size: 4.5rem;
    margin-bottom: 2rem;
    line-height: 1.1;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero :focus-visible {
    outline-color: #ffffff;
  }

  .hero p {
    text-wrap: pretty;
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 3.5rem;
    font-family: var(--font-sans);
    letter-spacing: 0.05em;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .btn-light {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--bg-primary);
  }

  .btn-light:hover {
    background: #ffffff;
    border-color: #ffffff;
  }

  .section-header {
    margin-bottom: 5rem;
    text-align: center;
  }

  .section-header h2 {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 3rem;
  }

  .bg-secondary {
    background: var(--bg-secondary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .service-content h2 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  .check-list {
    list-style: none;
    margin: 3rem 0;
  }

  .check-list li {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .check-list li::before {
    content: "";
    flex: none;
    width: 1.25rem;
    height: 1px;
    background: var(--accent);
  }

  .service-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .text-link {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.4em;
  }

  .text-link:hover {
    text-decoration-thickness: 2px;
  }

  .service-image img {
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr !important;
      gap: 4rem;
    }

    .hero {
      height: auto !important;
      min-height: 70vh !important;
      padding: 7rem 1.5rem 3rem;
      background: linear-gradient(
          to top,
          rgba(24, 18, 12, 0.88) 0%,
          rgba(24, 18, 12, 0.78) 60%,
          rgba(24, 18, 12, 0.55) 85%,
          rgba(24, 18, 12, 0.35) 100%
        ),
        url("/images/properties/jackson/EL8A9744.jpg");
      background-size: cover;
      background-position: center;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 8vw, 4rem) !important;
    }

    .hero-actions {
      flex-direction: column !important;
      gap: 1rem !important;
      width: 100% !important;
      max-width: 400px !important;
      margin: 0 auto !important;
    }

    .hero-actions .btn {
      width: 100% !important;
    }

    .property-grid {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }

  @media screen and (max-width: 480px) {
    .hero-actions {
      flex-direction: column !important;
      gap: 1rem;
    }

    .hero-actions .btn {
      width: 100% !important;
    }

    .section-header h2 {
      font-size: 2.5rem !important;
    }

    .hero h1 {
      font-size: 2.5rem !important;
    }
  }
</style>
