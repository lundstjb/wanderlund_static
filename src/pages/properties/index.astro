---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import SearchWidget from "../../components/SearchWidget.astro";
import { properties } from "../../data/properties";
---

<Layout
  title="Knoxville Vacation Rentals"
  description="Boutique vacation rentals in Knoxville, TN, including Old City condos and a South Knoxville townhome. Book direct on our site or on Airbnb."
>
  <Header />

  <main>
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h1>Knoxville Vacation Rentals</h1>
          <p>Explore our hand-picked properties across Knoxville, Tennessee.</p>
        </div>
        <div class="search-bar">
          <SearchWidget resultsUrl="/search/" />
        </div>
        <div class="property-grid">
          {properties.map((property) => <PropertyCard property={property} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .search-bar {
    margin-bottom: 5rem;
  }

  .section-header h1 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .section-header p {
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 4rem;
  }
</style>
